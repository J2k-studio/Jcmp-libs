#import <stdlib>
#import <native>
i64 main() {
    i64 lib = Native::open("libvulkan.so");         // build with:  jcmp -dyn native.jk -o native
    if lib == 0 { cout << "no libvulkan (build with jcmp -dyn)\n"; return 1; }
    i64 fn = Native::sym(lib, "vkEnumerateInstanceVersion");
    char out[16];
    out[0] = 0; out[1] = 0; out[2] = 0; out[3] = 0;
    Native::call1(fn, (i64)@out);
    i64 v = Native::peek32((i64)@out);
    cout << "Vulkan " << (v >> 22) << "." << ((v >> 12) & 1023) << "\n";
    return 0;
}
